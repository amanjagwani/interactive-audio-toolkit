{
  "name": "InteractiveAudioToolkit",
  "version": "0.2.0",
  "description": "Header-only toolkit for interactive audio on ESP32: sensors, threshold triggers, step sequencer, I2S synth, stepper/relay/DC motor outputs.",
  "keywords": ["audio", "synth", "sequencer", "sensors", "i2s", "esp32"],
  "repository": {
    "type": "git",
    "url": "https://github.com/amanjagwani/interactive-audio-toolkit.git"
  },
  "authors": [{ "name": "Aman Jagwani", "maintainer": true }],
  "license": "BSD-3-Clause",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": [
    { "owner": "bblanchon", "name": "ArduinoJson", "version": "^7.4.3" },
    { "owner": "sparkfun", "name": "SparkFun VL53L1X 4m Laser Distance Sensor", "version": "^1.2.12" },
    { "owner": "opensensinglab", "name": "TFMini", "version": "^0.1.0" },
    { "owner": "waspinator", "name": "AccelStepper", "version": "^1.64.0" },
    { "owner": "budryerson", "name": "TFMPI2C", "version": "^1.6.0" },
    { "owner": "olkal", "name": "HX711_ADC", "version": "^1.2.12" },
    { "owner": "boschsensortec", "name": "BME68x Sensor library", "version": "^1.2.40408" },
    { "owner": "esp32async", "name": "ESPAsyncWebServer", "version": "^3.12.1" },
    { "owner": "esp32async", "name": "AsyncTCP", "version": "^3.5.0" }
  ],
  "export": {
    "include": ["src", "examples", "library.json", "LICENSE", "README.md"]
  }
}
